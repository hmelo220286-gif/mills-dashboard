    '<div class="mf"><label>Data Prev. Entrega</label><span>'+esc(e2.dp||d.data_prev||'\u2014')+'</span></div>'+
    '<div class="mf full"><label>Observa\u00e7\u00e3o</label><span style="white-space:pre-wrap">'+esc(e2.ob||d.obs_op||'\u2014')+'</span></div>'+
    '</div>';
  document.getElementById('mbg').classList.add('show');
