try{ EDITS = JSON.parse(localStorage.getItem('mills_v3')||'{}'); }catch(e){}

var PAL=['#004042','#F37021','#2e86ab','#a23b72','#f18f01','#c73e1d','#3b1f2b','#14603a','#0e7490','#7c3aed'];

function gv(id){ var e=document.getElementById(id); return e?e.value:''; }

function getFilters(){
  return {
    frota:(gv('gF')||'').toLowerCase().trim(),
    enc:gv('gEnc'), polo:gv('gPol'), est:gv('gEst'), cid:gv('gCid'), uni:gv('gUni'),
    grp:gv('gGrp'), mrc:gv('gMrc'), crit:gv('gCrit'), dcrit:gv('gDCrit')
  };
}

function filterMR(f){
  return BASE_MR.filter(function(d){
    if(f.frota && d.frota.toLowerCase().indexOf(f.frota)<0) return false;
    if(f.enc   && (d.encarregado||'')!==f.enc)             return false;
    if(f.polo  && (d.polo||'')!==f.polo)                   return false;
    if(f.est   && (d.estado||'')!==f.est)                  return false;
    if(f.cid   && (d.cidade||'')!==f.cid)                  return false;
    if(f.uni   && (d.unidade||'')!==f.uni)                 return false;
    if(f.grp   && (d.grupo_norm||d.grupo||'')!==f.grp)     return false;
    if(f.mrc   && (d.marca||'')!==f.mrc)                   return false;
    if(f.crit){
      if(f.crit==='SEM' &&  d.criticidade) return false;
      if(f.crit!=='SEM' &&  d.criticidade!==f.crit) return false;
    }
    return true;
  });
}

function filterDESL(f, frotas_set){
  return BASE_DESL.filter(function(d){
    if(frotas_set && (f.est||f.grp||f.mrc||f.crit)){
      if(!frotas_set[d.frota]) return false;
    }
    if(f.frota && d.frota.toLowerCase().indexOf(f.frota)<0) return false;
    if(f.enc   && (d.enc||'')!==f.enc)                      return false;
    if(f.polo  && (d.polo||'')!==f.polo)                    return false;
    if(f.dcrit && (d.crit_pred||'')!==f.dcrit)              return false;
    return true;
  });
}

function applyGlobalFilter(){
  var f = getFilters();
  VIS_MR = filterMR(f);
  var frotas_set = null;
  if(f.est||f.grp||f.mrc||f.crit){
    frotas_set = {};
    VIS_MR.forEach(function(d){ frotas_set[d.frota]=1; });
  }
  VIS_DESL = filterDESL(f, frotas_set);
  var cnt = document.getElementById('g-count');
  if(cnt) cnt.textContent = VIS_MR.length + ' equip.';
  try{ updateDashboard(VIS_MR);     }catch(e){ console.warn('dash:',e); }
  try{ updateTabela(VIS_MR);        }catch(e){ console.warn('tabela:',e); }
  try{ updateDeslocamento(VIS_DESL);}catch(e){ console.warn('desl:',e); }
}

function resetGlobalFilter(){
  var fF=document.getElementById('gF'); if(fF)fF.value='';
  ['gEnc','gPol','gEst','gCid','gUni','gGrp','gMrc','gCrit','gDCrit'].forEach(function(id){
    var e=document.getElementById(id);if(e)e.value='';
  });
  applyGlobalFilter();
}

// ── DASHBOARD ──────────────────────────────────────────────────────────
function updateDashboard(src){
  var sv=function(id,v){var e=document.getElementById(id);if(e)e.textContent=v;};
  sv('k0',src.length);
  sv('k1',src.filter(function(x){return cc(x.criticidade)==='U';}).length);
  sv('k2',src.filter(function(x){return x.status&&x.status.indexOf('Opera')>=0;}).length);
  sv('k3',src.filter(function(x){return cc(x.criticidade)==='C';}).length);
  sv('k4',src.filter(function(x){return cc(x.criticidade)==='N';}).length);
  sv('k5',src.filter(function(x){return cc(x.criticidade)==='O';}).length);
  sv('k6',src.filter(function(x){return x.horas_apos&&parseFloat(x.horas_apos)>500;}).length);
  sv('k7',src.filter(function(x){return !x.criticidade;}).length);
  drawChartsFrom(src);
  buildTop10From(src);
}

function drawChartsFrom(src){
  var cr=cntBy(src,function(d){return d.criticidade||'';});
  drawPie('ch0',['Urgente','Comunicar','Normal','Rodante OK','Sem dados'],
    [cr['URGENTE']||0,cr['COMUNICAR OFICINA']||0,cr['NORMAL']||0,cr['RODANTE OK']||0,cr['']||0],
    ['#b91c1c','#b45309','#166534','#0e7490','#c8cdd5']);
  var po=Object.entries(cntBy(src,function(d){return d.polo;})).sort(function(a,b){return b[1]-a[1];}).slice(0,10);
  drawHBar('ch1',po.map(function(x){return x[0];}),po.map(function(x){return x[1];}),'#004042');
  var ma=Object.entries(cntBy(src,function(d){return d.marca;})).sort(function(a,b){return b[1]-a[1];});
  drawPie('ch2',ma.map(function(x){return x[0];}),ma.map(function(x){return x[1];}),PAL);
  var gr=Object.entries(cntBy(src,function(d){return d.grupo_norm||d.grupo;})).sort(function(a,b){return b[1]-a[1];});
  drawPie('ch3',gr.map(function(x){return x[0];}),gr.map(function(x){return x[1];}),PAL.slice(0).reverse());
  var st=Object.entries(cntBy(src,function(d){return d.status;})).sort(function(a,b){return b[1]-a[1];}).slice(0,6);
  drawPie('ch4',st.map(function(x){return x[0];}),st.map(function(x){return x[1];}),PAL);
  var t8=src.filter(function(d){return d.horas_apos&&parseFloat(d.horas_apos)>500;})
    .sort(function(a,b){return parseFloat(b.horas_apos)-parseFloat(a.horas_apos);}).slice(0,8);
  drawHBar('ch5',t8.map(function(d){return d.frota;}),
           t8.map(function(d){return Math.round(parseFloat(d.horas_apos));}),'#b91c1c');
}

function buildTop10From(src){
  var top=src.filter(function(d){return d.horas_apos&&d.horas_apos!=='';})
    .sort(function(a,b){return parseFloat(b.horas_apos)-parseFloat(a.horas_apos);}).slice(0,10);
  var mx=parseFloat((top[0]||{}).horas_apos||1);
  var tb=document.getElementById('top10'); if(!tb)return;
  var h='';
  top.forEach(function(d){
    var hs=parseFloat(d.horas_apos)||0;
    var bw=Math.round(hs/mx*100),bc=hs>1000?'#b91c1c':hs>500?'#b45309':'#166534';
    var k=cc(d.criticidade),rc=k==='U'?'rU':k==='C'?'rC':'';
    h+='<tr class="'+rc+'" onclick="openM('+BASE_MR.indexOf(d)+')">';
    h+='<td><span class="fm">'+esc(d.frota||'')+'</span></td>';
    h+='<td>'+esc(d.modelo||'\u2014')+'</td><td>'+esc(d.polo||'\u2014')+'</td>';
    h+='<td>'+esc(d.cidade||'')+(d.estado?' / '+d.estado:'')+'</td>';
    h+='<td><b style="color:'+bc+'">'+nf(hs)+'</b><div class="hb"><div class="hf" style="width:'+bw+'%;background:'+bc+'"></div></div></td>';
    h+='<td>'+esc(d.hor_atual||'\u2014')+'</td>';
    h+='<td><span class="badge b'+k+'">'+cl(d.criticidade)+'</span></td></tr>';
  });
  tb.innerHTML=h;
}

// ── TABELA ─────────────────────────────────────────────────────────────
function updateTabela(src){
  PG=1;
  var vis=[...src];
  if(SC>=0){
    var skf=[
      function(d){return d.frota;},function(d){return d.grupo_norm||d.grupo;},
      function(d){return d.marca;},function(d){return d.unidade;},
      function(d){return d.cidade;},function(d){return d.status;},
      function(d){return d.criticidade;},function(d){return d.encarregado;},
      function(d){return d.om;},function(d){return parseFloat(d.hor_atual)||0;},
      function(d){return parseFloat(d.horas_apos)||0;},function(d){return d.data_exec;}
    ];
    var fn=skf[SC];
    if(fn) vis.sort(function(a,b){
      var va=fn(a),vb=fn(b);
      if(typeof va==='number')return(va-vb)*SD;
      return String(va||'').localeCompare(String(vb||''),'pt')*SD;
    });
  } else {
    var ord={U:0,C:1,N:2,O:3,Z:4};
    vis.sort(function(a,b){return(ord[cc(a.criticidade)]||4)-(ord[cc(b.criticidade)]||4);});
  }
  var el=document.getElementById('fcnt'); if(el)el.textContent=vis.length+' resultados';
  renderRows(vis);
}

function renderRows(vis){
  var sz=parseInt(gv('ps'))||50, tot=vis.length;
  var pgs=Math.max(1,Math.ceil(tot/sz));
  if(PG>pgs)PG=pgs;
  var s=(PG-1)*sz, e=Math.min(s+sz,tot), h='';
  vis.slice(s,e).forEach(function(d){
    var idx=BASE_MR.indexOf(d);
    var ed2=EDITS[d.frota]||{};
    var dp=ed2.dp||toISO(d.data_prev)||'';
    var ob=ed2.ob||d.obs_op||'';
    var k=cc(d.criticidade),rc=k==='U'?'rU':k==='C'?'rC':'';
    var hs=parseFloat(d.horas_apos)||0;
    var bw=Math.min(100,Math.round(hs/10)),bc=hs>500?'#b91c1c':hs>250?'#b45309':'#166534';
    h+='<tr class="'+rc+'" onclick="openM('+idx+')">';
    h+='<td><span class="fm">'+esc(d.frota||'')+'</span><span class="sub">'+esc(d.modelo||'')+'</span></td>';
    h+='<td>'+esc((d.grupo_norm||d.grupo||'\u2014').substring(0,20))+'</td>';
    h+='<td>'+esc(d.marca||'\u2014')+'</td>';
    h+='<td>'+esc((d.unidade||'\u2014').substring(0,20))+'<span class="sub">'+esc(d.polo||'')+'</span></td>';
    h+='<td>'+esc(d.cidade||'\u2014')+'<span class="sub">'+esc(d.estado||'')+'</span></td>';
    h+='<td style="font-size:11px;color:var(--tx2)">'+esc((d.status||'\u2014').substring(0,18))+'</td>';
    h+='<td><span class="badge b'+k+'">'+cl(d.criticidade)+'</span></td>';
    h+='<td>'+esc(d.encarregado||'\u2014')+'<span class="sub">'+esc(d.gerente||'')+'</span></td>';
    h+='<td style="font-family:monospace;font-size:11px">'+esc(d.om||'\u2014')+'</td>';
    h+='<td>'+esc(d.hor_atual||'\u2014')+(hs?'<div class="hb"><div class="hf" style="width:'+bw+'%;background:'+bc+'"></div></div>':'')+'</td>';
    h+='<td style="'+(hs>500?'color:#b91c1c;font-weight:700':'')+'">'+(hs?nf(hs):'\u2014')+'</td>';
    h+='<td style="font-size:11px;color:var(--tx3)">'+esc(d.data_exec||'\u2014')+'</td>';
    h+='<td style="font-size:11px;color:var(--tx2);max-width:220px;white-space:normal">'+esc((d.desc_om||'').substring(0,120))+'</td>';
    h+='<td onclick="event.stopPropagation()"><input type="date" class="ei" data-fr="'+esc(d.frota)+'" data-f="dp" value="'+esc(dp)+'" onchange="ed(this)" onclick="event.stopPropagation()"></td>';
    h+='<td onclick="event.stopPropagation()" style="min-width:200px"><textarea class="ei" rows="3" data-fr="'+esc(d.frota)+'" data-f="ob" oninput="ed(this)" onclick="event.stopPropagation()" style="width:100%;min-width:190px;padding:6px 8px;border:1.5px solid var(--brd);border-radius:5px;font-size:12px;resize:vertical;background:#fff;color:var(--tx);min-height:62px;line-height:1.4">'+esc(ob)+'</textarea></td>';
    h+='</tr>';
  });
  var tb=document.getElementById('mtb'); if(tb)tb.innerHTML=h;
  var pi=document.getElementById('pi'); if(pi)pi.textContent='Mostrando '+(s+1)+'\u2013'+e+' de '+tot;
  // Paginação
  var pb=document.getElementById('pb'); if(!pb)return; pb.innerHTML='';
  function mkb(t,v,dis,act){
    var b=document.createElement('button');b.className='pb'+(act?' act':'');
    b.textContent=t;b.disabled=!!dis;
    b.onclick=function(){PG=v;renderRows(vis);};pb.appendChild(b);
  }
  mkb('\u00ab',1,PG===1);mkb('\u2039',PG-1,PG===1);
  var ps2=Math.max(1,PG-2),pe2=Math.min(pgs,ps2+4);
  for(var p=ps2;p<=pe2;p++)mkb(p,p,false,p===PG);
  mkb('\u203a',PG+1,PG===pgs);mkb('\u00bb',pgs,PG===pgs);
}

function srt(col){
  if(SC===col)SD*=-1;else{SC=col;SD=1;}
  document.querySelectorAll('#mh th').forEach(function(th,i){
    th.classList.remove('asc','desc');if(i===col)th.classList.add(SD===1?'asc':'desc');
  });
  updateTabela(VIS_MR);
}

// ── DESLOCAMENTO ───────────────────────────────────────────────────────
function updateDeslocamento(src){
  var sv=function(id,v){var e=document.getElementById(id);if(e)e.textContent=v;};
  sv('dk0',src.length);
  sv('dk1',src.filter(function(d){return d.crit_pred==='Cr\u00edtico';}).length);
  sv('dk2',src.filter(function(d){return d.crit_pred==='Aten\u00e7\u00e3o';}).length);
  sv('dk3',src.filter(function(d){return d.crit_pred==='Normal';}).length);
  sv('dk4',src.filter(function(d){return d.crit_pred==='Sem registro';}).length);
  sv('dk5',src.reduce(function(a,d){return a+d.critico;},0).toLocaleString('pt-BR'));
  sv('dk6',src.reduce(function(a,d){return a+d.atencao;},0).toLocaleString('pt-BR'));
  // Gráficos
  var cr={};src.forEach(function(d){cr[d.crit_pred]=(cr[d.crit_pred]||0)+1;});
  drawPie('dch0',['Cr\u00edtico','Aten\u00e7\u00e3o','Normal','Sem registro'],
    [cr['Cr\u00edtico']||0,cr['Aten\u00e7\u00e3o']||0,cr['Normal']||0,cr['Sem registro']||0],
    ['#b91c1c','#f59e0b','#16a34a','#d1d5db']);
  var em={};src.forEach(function(d){if(d.enc&&d.enc!=='nan')em[d.enc]=(em[d.enc]||0)+d.critico;});
  var ep=Object.entries(em).sort(function(a,b){return b[1]-a[1];}).slice(0,10);
  drawHBar('dch1',ep.map(function(x){return x[0];}),ep.map(function(x){return x[1];}),'#b91c1c');
  var pm={};src.forEach(function(d){if(d.polo&&d.polo!=='nan')pm[d.polo]=(pm[d.polo]||0)+d.critico;});
  var pp=Object.entries(pm).sort(function(a,b){return b[1]-a[1];}).slice(0,10);
  drawHBar('dch2',pp.map(function(x){return x[0];}),pp.map(function(x){return x[1];}),'#004042');
  var tC=src.reduce(function(a,d){return a+d.critico;},0);
  var tA=src.reduce(function(a,d){return a+d.atencao;},0);
  var tN=src.reduce(function(a,d){return a+d.normal;},0);
  var tS=src.reduce(function(a,d){return a+d.sem_reg;},0);
  drawPie('dch3',['Cr\u00edtico','Aten\u00e7\u00e3o','Normal','Sem reg.'],[tC,tA,tN,tS],
    ['#b91c1c','#f59e0b','#16a34a','#d1d5db']);
  var tp=[...src].sort(function(a,b){return b.critico-a.critico;}).slice(0,10);
  drawHBar('dch4',tp.map(function(d){return d.frota;}),tp.map(function(d){return d.critico;}),'#b91c1c');
  // Tabela
  var dsrc=DESL_SC>=0?[...src].sort(function(a,b){
    var ks=['frota','operacao','enc','polo','crit_pred','critico','atencao','normal','sem_reg','total','dist_max'];
    var k=ks[DESL_SC];var va=a[k],vb=b[k];
    if(typeof va==='number')return(va-vb)*DESL_SD;
    return String(va||'').localeCompare(String(vb||''),'pt')*DESL_SD;
  }):[...src].sort(function(a,b){
    var o={'Cr\u00edtico':0,'Aten\u00e7\u00e3o':1,'Normal':2,'Sem registro':3};
    return(o[a.crit_pred]||4)-(o[b.crit_pred]||4);
  });
  var h='';
  dsrc.forEach(function(d){
    var bk=d.crit_pred==='Cr\u00edtico'?'C':d.crit_pred==='Aten\u00e7\u00e3o'?'A':d.crit_pred==='Normal'?'N':'S';
    var tot2=d.total||1;
    var wc=Math.round(d.critico/tot2*100),wa=Math.round(d.atencao/tot2*100);
    var wn=Math.round(d.normal/tot2*100),ws=Math.round(d.sem_reg/tot2*100);
    var dist=d.dist_max>0?d.dist_max.toLocaleString('pt-BR',{maximumFractionDigits:1})+' km':'\u2014';
    h+='<tr><td><span class="fm">'+esc(d.frota)+'</span></td>';
    h+='<td style="font-size:11px">'+esc(d.operacao||'\u2014')+'</td>';
    h+='<td><b>'+esc(d.enc||'\u2014')+'</b></td>';
    h+='<td style="font-size:11px">'+esc(d.polo||'\u2014')+'</td>';
    h+='<td><span class="badge badge-'+bk+'">'+esc(d.crit_pred)+'</span></td>';
    h+='<td style="color:#b91c1c;font-weight:700">'+d.critico+'</td>';
    h+='<td style="color:#b45309;font-weight:700">'+d.atencao+'</td>';
    h+='<td style="color:#166534">'+d.normal+'</td>';
    h+='<td style="color:#9ca3af">'+d.sem_reg+'</td>';
    h+='<td>'+d.total+'</td><td style="font-size:11px">'+dist+'</td>';
    h+='<td><div class="bar-wrap">';
    if(wc>0)h+='<div class="bar-c" style="flex:'+wc+'"></div>';
    if(wa>0)h+='<div class="bar-a" style="flex:'+wa+'"></div>';
    if(wn>0)h+='<div class="bar-n" style="flex:'+wn+'"></div>';
    if(ws>0)h+='<div class="bar-s" style="flex:'+ws+'"></div>';
    h+='</div></td></tr>';
  });
  var dtb=document.getElementById('dtbody');if(dtb)dtb.innerHTML=h;
}

function deslSort(col){
  if(DESL_SC===col)DESL_SD*=-1;else{DESL_SC=col;DESL_SD=1;}
  document.querySelectorAll('#dtbl th').forEach(function(th,i){
    th.classList.remove('asc','desc');if(i===col)th.classList.add(DESL_SD===1?'asc':'desc');
  });
  updateDeslocamento(VIS_DESL);
}

// ── SWITCH TAB ─────────────────────────────────────────────────────────
function switchTab(id,el){
  document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active');});
  document.querySelectorAll('.tab').forEach(function(t){t.classList.remove('active');});
  document.getElementById('pg-'+id).classList.add('active');
  el.classList.add('active');
  try{
    if(id==='dashboard')   updateDashboard(VIS_MR);
    if(id==='tabela')      updateTabela(VIS_MR);
    if(id==='deslocamento')updateDeslocamento(VIS_DESL);
  }catch(e){console.warn('switchTab:',e);}
}

