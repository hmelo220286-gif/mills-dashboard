<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mills – Relatório Gerencial Material Rodante</title>
<style>
:root{
  --mg:#004042;--mg2:#005a5c;--mo:#F37021;--mo2:#d4601a;
  --ice:#EBF6F5;--ice2:#d4eeec;
  --bg:#f0f3f5;--card:#fff;--brd:#dde3e8;--brd2:#c2c8d4;
  --tx:#1a2228;--tx2:#4a5568;--tx3:#8a96a4;
  --red:#b91c1c;--rbg:#fef2f2;
  --amb:#b45309;--abg:#fffbeb;
  --grn:#166534;--gbg:#f0fdf4;
  --tel:#0e7490;--tbg:#ecfeff;
  --r:8px;--sh:0 1px 3px rgba(0,0,0,.08),0 4px 12px rgba(0,0,0,.04);
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
     background:var(--bg);color:var(--tx);font-size:13px}
.hd{background:var(--mg);height:52px;display:flex;align-items:center;
    padding:0 20px;gap:12px;position:sticky;top:0;z-index:100;
    box-shadow:0 2px 8px rgba(0,0,0,.3)}
.hd-brand{display:flex;align-items:center;gap:10px;flex-shrink:0}
.wm{font-size:22px;font-weight:900;color:#fff;letter-spacing:-1px;font-family:Arial Black,Arial,sans-serif}
.hs{font-size:9px;color:rgba(255,255,255,.55);text-transform:uppercase;letter-spacing:.08em;line-height:1.3;font-weight:600}
.hdiv{width:1px;height:28px;background:rgba(255,255,255,.2)}
.htit{font-size:13px;font-weight:600;color:rgba(255,255,255,.9);white-space:nowrap}
.hsp{flex:1}
.hm{font-size:11px;color:rgba(255,255,255,.5);white-space:nowrap}
.hb{padding:6px 12px;border-radius:6px;border:none;font-size:12px;font-weight:600;
     cursor:pointer;display:inline-flex;align-items:center;gap:5px;white-space:nowrap;transition:all .15s}
.hb:hover{opacity:.85}
.hb.hbg{background:#fff !important;color:#004042 !important;border:1px solid rgba(255,255,255,.5) !important;font-weight:700}
.hb.hbg:hover{background:#F37021 !important;color:#fff !important;border-color:#F37021 !important}
.hb.hbo{background:#F37021 !important;color:#fff !important;border:1px solid #F37021 !important;font-weight:700}
.hbs{background:#166534;color:#fff}
.tabs{background:var(--mg);display:flex;padding:0 20px;border-top:1px solid rgba(255,255,255,.08)}
.tab{padding:9px 18px;font-size:12px;font-weight:600;color:rgba(255,255,255,.55);
      cursor:pointer;border-bottom:3px solid transparent;user-select:none;transition:all .15s;
      text-transform:uppercase;letter-spacing:.04em}
.tab:hover{color:rgba(255,255,255,.85)}
.tab.active{color:#fff;border-bottom-color:var(--mo)}
.page{display:none;padding:16px 20px 110px}
.page.active{display:block}
/* KPIs */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:16px}
.kpi{background:var(--card);border-radius:var(--r);padding:14px 16px;
      box-shadow:var(--sh);border:1px solid var(--brd);overflow:hidden;position:relative}
.kpi::after{content:"";position:absolute;top:0;left:0;right:0;height:3px}
.k0::after{background:var(--mg)} .k1::after{background:var(--mo)}
.k2::after{background:var(--red)} .k3::after{background:var(--amb)}
.k4::after{background:var(--grn)} .k5::after{background:var(--tel)}
.k6::after{background:#7c3aed} .k7::after{background:var(--brd2)}
.kl{font-size:10px;font-weight:700;color:var(--tx3);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px}
.kv{font-size:26px;font-weight:800;line-height:1;letter-spacing:-.02em}
.k0 .kv{color:var(--mg)} .k1 .kv{color:var(--mo)} .k2 .kv{color:var(--red)}
.k3 .kv{color:var(--amb)} .k4 .kv{color:var(--grn)} .k5 .kv{color:var(--tel)}
.k6 .kv{color:#7c3aed} .k7 .kv{color:var(--tx2)}
.ks{font-size:10px;color:var(--tx3);margin-top:3px}
/* SECTION */
.sec{font-size:11px;font-weight:700;color:var(--mg);text-transform:uppercase;
      letter-spacing:.06em;margin:16px 0 10px;display:flex;align-items:center;gap:8px}
.sec::after{content:"";flex:1;height:1px;background:var(--brd)}
/* CHARTS GRID */
.dash-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px}
.dash-grid.two{grid-template-columns:1fr 1fr}
.dash-grid.two-one{grid-template-columns:2fr 1fr}
.ch{background:var(--card);border-radius:var(--r);padding:14px;
     box-shadow:var(--sh);border:1px solid var(--brd)}
.ch.span2{grid-column:span 2}
.cht{font-size:11px;font-weight:700;color:var(--tx3);
      text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px}
canvas{display:block;max-width:100%}
/* MAP */
.map-wrap{position:relative}
#br-map{width:100%;height:auto}
.map-legend{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.ml-item{display:flex;align-items:center;gap:4px;font-size:10px;color:var(--tx2)}
.ml-dot{width:10px;height:10px;border-radius:50%}
/* TOOLTIP MAPA */
#map-tip{position:fixed;background:rgba(0,40,42,.9);color:#fff;padding:8px 12px;
          border-radius:6px;font-size:12px;pointer-events:none;display:none;z-index:200;
          line-height:1.6;min-width:160px;box-shadow:0 4px 12px rgba(0,0,0,.25)}
/* FILTERS */
.filters{background:var(--card);border-radius:var(--r);padding:12px 14px;
          box-shadow:var(--sh);border:1px solid var(--brd);margin-bottom:12px}
.frow{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end}
.fg{display:flex;flex-direction:column;gap:3px;min-width:0}
.fgl{font-size:10px;font-weight:700;color:var(--tx3);text-transform:uppercase;letter-spacing:.05em;white-space:nowrap}
.fgi,.fgs{padding:6px 9px;border:1px solid var(--brd);border-radius:5px;font-size:12px;background:#fafbfc;color:var(--tx)}
.fgi{width:140px} .fgs{min-width:130px}
.fgi:focus,.fgs:focus{outline:none;border-color:var(--mo);background:#fff;box-shadow:0 0 0 2px rgba(243,112,33,.12)}
.fact{display:flex;gap:8px;align-items:flex-end;margin-left:auto;flex-wrap:wrap}
.fcnt{background:var(--ice);color:var(--mg);padding:6px 11px;border-radius:5px;font-size:12px;font-weight:700;white-space:nowrap}
/* TABLE BAR */
.tbar{display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap}
.tbtn{padding:5px 12px;border:1px solid #004042;border-radius:4px;background:#004042;
       font-size:11px;font-weight:700;color:#fff;cursor:pointer;text-transform:uppercase;
       letter-spacing:.03em;display:inline-flex;align-items:center;gap:4px;transition:all .15s}
.tbtn:hover{background:#F37021;border-color:#F37021;color:#fff}
.tsp{flex:1}
/* TABLE */
.tw{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);border:1px solid var(--brd);overflow:hidden}
.ts{overflow-x:auto;overflow-y:auto;max-height:460px}
table{width:100%;border-collapse:collapse;font-size:12px}
thead{position:sticky;top:0;z-index:5}
th{padding:9px 11px;text-align:left;font-size:10px;font-weight:700;color:var(--tx2);
    background:#f2f5f7;border-bottom:2px solid var(--brd);white-space:nowrap;
    cursor:pointer;user-select:none;text-transform:uppercase;letter-spacing:.04em}
th:hover{background:#ebeff3;color:var(--mg)}
th.asc::after{content:" B2";font-size:9px;color:var(--mg)}
th.desc::after{content:" BC";font-size:9px;color:var(--mg)}
th.ec{background:#fef5ed;color:var(--mo2)} th.ec:hover{background:#fee8d4}
tbody tr{border-bottom:1px solid #f0f3f5;cursor:pointer;transition:background .08s}
tbody tr:hover{background:#f7f9fb}
tbody tr.rU{background:#fff5f5} tbody tr.rU:hover{background:#ffe8e8}
tbody tr.rC{background:#fffdf5} tbody tr.rC:hover{background:#fff8e6}
td{padding:7px 11px;vertical-align:middle;max-width:190px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fm{font-family:monospace;font-weight:700;font-size:12px;color:var(--mg);letter-spacing:.03em}
.sub{font-size:10px;color:var(--tx3);display:block;margin-top:1px}
.badge{display:inline-flex;align-items:center;gap:3px;padding:2px 7px;
        border-radius:8px;font-size:10px;font-weight:700;white-space:nowrap;letter-spacing:.03em}
.bU{background:var(--rbg);color:var(--red)} .bC{background:var(--abg);color:var(--amb)}
.bN{background:var(--gbg);color:var(--grn)} .bO{background:var(--tbg);color:var(--tel)}
.bZ{background:#f0f3f5;color:var(--tx3)}
.hb{height:3px;border-radius:2px;background:#e8ecef;margin-top:3px;min-width:60px}
.hf{height:100%;border-radius:2px}
td input.ei,td textarea.ei{width:100%;padding:3px 6px;border:1px solid var(--brd);
    border-radius:4px;font-size:11px;font-family:inherit;background:transparent;color:var(--tx)}
td input.ei:focus,td textarea.ei:focus{outline:none;border-color:var(--mo);background:#fff}
/* PAG */
.pag{display:flex;align-items:center;justify-content:space-between;
      padding:10px 14px;border-top:1px solid var(--brd);background:#fafbfc}
.pbtns{display:flex;gap:3px}
.pb{padding:4px 9px;border:1px solid var(--brd);border-radius:4px;background:#fff;
     font-size:11px;font-weight:600;cursor:pointer;color:var(--tx2);transition:all .12s}
.pb:hover:not(:disabled){border-color:var(--mo);color:var(--mo)}
.pb.act{background:var(--mo);color:#fff;border-color:var(--mo)}
.pb:disabled{opacity:.3;cursor:not-allowed}
.pi{font-size:11px;color:var(--tx3)}
.ps{padding:3px 7px;border:1px solid var(--brd);border-radius:4px;font-size:11px;background:#fff;color:var(--tx2)}
/* MODAL */
.mbg{display:none;position:fixed;inset:0;background:rgba(0,20,30,.6);
      z-index:200;align-items:center;justify-content:center;padding:16px}
.mbg.show{display:flex}
.modal{background:#fff;border-radius:10px;max-width:700px;width:100%;
        max-height:90vh;overflow:hidden;display:flex;flex-direction:column;
        box-shadow:0 20px 60px rgba(0,0,0,.3)}
.mhd{background:var(--mg);padding:14px 18px;display:flex;align-items:center;gap:10px}
.mhd h2{font-size:14px;font-weight:700;color:#fff;flex:1}
.mclose{background:rgba(255,255,255,.15);border:none;color:#fff;
         width:26px;height:26px;border-radius:50%;cursor:pointer;font-size:14px;
         display:flex;align-items:center;justify-content:center}
.mclose:hover{background:rgba(255,255,255,.3)}
.mbody{padding:16px;overflow-y:auto;flex:1}
.mgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.mf{padding:9px 11px;background:#f8f9fb;border-radius:6px;border:1px solid var(--brd)}
.mf label{font-size:9px;font-weight:700;color:var(--tx3);text-transform:uppercase;
            letter-spacing:.05em;display:block;margin-bottom:2px}
.mf.full{grid-column:span 2}
/* COL PANEL */
.cwrap{position:relative}
.cpanel{display:none;position:absolute;left:0;top:calc(100% + 4px);
         background:#fff;border:1px solid var(--brd);border-radius:var(--r);
         box-shadow:var(--sh);padding:10px 12px;z-index:50;min-width:200px}
.cpanel.show{display:block}
.cpanel label{display:flex;align-items:center;gap:7px;padding:4px 0;cursor:pointer;font-size:12px;color:var(--tx)}
.cpanel label:hover{color:var(--mg)}
.cpanel input[type=checkbox]{accent-color:var(--mo)}
/* IMPORT BAR */
.ibar{position:fixed;bottom:0;left:0;right:0;background:#fff;
       border-top:2px solid var(--brd);padding:10px 20px;
       display:flex;align-items:center;gap:12px;z-index:50;
       box-shadow:0 -4px 16px rgba(0,0,0,.08)}
.ibtn{padding:10px 22px;background:var(--mo);color:#fff;border:none;
       border-radius:7px;font-size:14px;font-weight:700;cursor:pointer;
       display:inline-flex;align-items:center;gap:8px;
       box-shadow:0 4px 14px rgba(243,112,33,.4);transition:all .2s}
.ibtn:hover{background:var(--mo2);transform:translateY(-2px)}
.ihin{font-size:12px;color:var(--tx3);line-height:1.5}
.ihin b{color:var(--tx2)}
.exp-btn{padding:10px 18px;background:var(--mg);color:#fff;border:none;
          border-radius:7px;font-size:13px;font-weight:700;cursor:pointer;
          display:inline-flex;align-items:center;gap:7px;transition:all .2s}
.exp-btn:hover{background:var(--mg2);transform:translateY(-2px)}
/* UPLOAD */
.ubg{display:none;position:fixed;inset:0;background:rgba(0,20,30,.65);
      z-index:200;align-items:center;justify-content:center}
.ubg.show{display:flex}
.ucard{background:#fff;border-radius:12px;padding:28px;max-width:460px;
        width:90%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.25)}
.ucard h2{font-size:16px;font-weight:700;color:var(--mg);margin-bottom:6px}
.ucard p{font-size:13px;color:var(--tx2);margin-bottom:18px}
.udrop{border:2px dashed var(--mo);border-radius:9px;padding:24px;
        background:var(--ice);cursor:pointer;transition:all .2s;margin-bottom:14px}
.udrop:hover,.udrop.drag{background:var(--ice2);border-color:var(--mg)}
.udrop p{font-size:13px;color:var(--tx2);margin:8px 0 0}
.ufmt{font-size:11px;color:var(--tx3);margin-top:6px}
.ubr{display:flex;gap:10px;justify-content:center}
.ucan{padding:8px 16px;border:1px solid var(--brd);border-radius:6px;
       background:#fff;font-size:13px;cursor:pointer;color:var(--tx2)}
.toast{position:fixed;bottom:80px;right:20px;background:var(--mg);color:#fff;
        padding:9px 16px;border-radius:7px;font-size:12px;font-weight:600;
        opacity:0;transform:translateY(6px);transition:all .25s;pointer-events:none;
        z-index:300;box-shadow:0 4px 14px rgba(0,64,66,.35)}
.toast.show{opacity:1;transform:translateY(0)}
#map-tip b{display:block;font-size:13px;margin-bottom:2px}
@media(max-width:900px){.dash-grid,.dash-grid.two,.dash-grid.two-one{grid-template-columns:1fr}.ch.span2{grid-column:span 1}}
@media(max-width:580px){.kpis{grid-template-columns:repeat(2,1fr)}.htit,.hm{display:none}}

.dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
.ch{background:var(--card);border-radius:var(--r);padding:18px 20px;box-shadow:var(--sh);border:1px solid var(--brd)}
.cht{font-size:12px;font-weight:700;color:var(--tx3);text-transform:uppercase;letter-spacing:.05em;margin-bottom:12px}
.desl-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:14px}
.desl-kpi{background:var(--card);border-radius:var(--r);padding:14px 16px;box-shadow:var(--sh);border:1px solid var(--brd);position:relative;overflow:hidden}
.desl-kpi::after{content:"";position:absolute;top:0;left:0;right:0;height:3px}
.dk-total::after{background:#004042}.dk-crit::after{background:#b91c1c}
.dk-atenc::after{background:#b45309}.dk-norm::after{background:#166534}.dk-sem::after{background:#9ca3af}
.desl-kpi .kl{font-size:10px;font-weight:700;color:var(--tx3);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px}
.desl-kpi .kv{font-size:26px;font-weight:800;line-height:1}
.dk-total .kv{color:#004042}.dk-crit .kv{color:#b91c1c}
.dk-atenc .kv{color:#b45309}.dk-norm .kv{color:#166534}.dk-sem .kv{color:#9ca3af}
.desl-kpi .ks{font-size:10px;color:var(--tx3);margin-top:3px}
.desl-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
.dch{background:var(--card);border-radius:var(--r);padding:18px 20px;box-shadow:var(--sh);border:1px solid var(--brd)}
.dcht{font-size:12px;font-weight:700;color:var(--tx3);text-transform:uppercase;letter-spacing:.05em;margin-bottom:12px}
.dtbl-scroll{overflow-x:auto;overflow-y:auto;max-height:420px}
.badge-C{background:#fef2f2;color:#b91c1c}.badge-A{background:#fffbeb;color:#b45309}
.badge-N{background:#f0fdf4;color:#166534}.badge-S{background:#f9fafb;color:#9ca3af}
.bar-wrap{display:flex;height:8px;border-radius:4px;overflow:hidden;gap:1px;min-width:80px;margin-top:3px}
.bar-c{background:#b91c1c}.bar-a{background:#f59e0b}.bar-n{background:#16a34a}.bar-s{background:#d1d5db}

</style>
</head>
<body>
<header class="hd">
  <div class="hd-brand">
    <span class="wm">mills</span>
    <span class="hs">Rental<br>Pesados</span>
  </div>
  <div class="hdiv"></div>
  <span class="htit">Relatório Gerencial – Material Rodante</span>
  <span class="hsp"></span>
  <span class="hm" id="hm">284 equipamentos&nbsp;|&nbsp;Ref. 06/07/2026</span>
  <button class="hb hbg" onclick="doExport('csv')">&#8595; CSV</button>
  <button class="hb hbg" onclick="doExport('excel')">&#8595; Excel</button>
</header>
<nav class="tabs">
  <div class="tab active" onclick="switchTab('dashboard',this)">&#9634; Dashboard</div>
  <div class="tab" onclick="switchTab('tabela',this)">&#9776; Tabela Detalhada</div>
  <div class="tab" onclick="switchTab('deslocamento',this)">&#128205; Deslocamento</div>
</nav>
<!-- DASHBOARD -->
<div id="sync-banner" style="background:linear-gradient(135deg,#004042,#005a5c);color:#fff;padding:8px 20px;display:flex;align-items:center;gap:12px;font-size:12px;border-bottom:2px solid #F37021">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="flex-shrink:0;opacity:.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
  <div style="flex:1"><b id="sync-label" style="font-size:12px;display:block;margin-bottom:1px">&#128308; Conectando...</b><span id="sync-sub" style="font-size:11px;opacity:.75">Aguarde</span></div>
</div>
<div id="global-filters" style="background:#004042;padding:10px 20px 12px;border-top:1px solid rgba(255,255,255,.1)">
  <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end">
    <div class="fg"><span class="fgl" style="color:rgba(255,255,255,.85)">Frota</span>
      <input class="fgi" id="gF" type="text" placeholder="Ex: EHS01254" oninput="applyGlobalFilter()"
        style="width:130px;background:#fff;border-color:#bbb;color:#1a2228">
    </div>
    <div class="fg"><span class="fgl" style="color:rgba(255,255,255,.85)">Encarregado</span>
      <select class="fgs" id="gEnc" onchange="applyGlobalFilter()"
        style="background:#fff;border-color:#bbb;color:#1a2228">
        <option value="">Todos</option><option value="Alexandre">Alexandre</option><option value="Bruno">Bruno</option><option value="Caio">Caio</option><option value="Cecilia Goncalves">Cecilia Goncalves</option><option value="Daniel">Daniel</option><option value="Eder Nunes">Eder Nunes</option><option value="Francinei">Francinei</option><option value="Hailton">Hailton</option><option value="Isaias">Isaias</option><option value="Jardel">Jardel</option><option value="Jonas">Jonas</option><option value="Julio Amorim">Julio Amorim</option><option value="Leasing - Henrique Melo">Leasing - Henrique Melo</option><option value="Luciano">Luciano</option><option value="Rafael">Rafael</option><option value="Silvio">Silvio</option><option value="Sérgio">Sérgio</option><option value="Tiago Alcino">Tiago Alcino</option>
      </select>
    </div>
    <div class="fg"><span class="fgl" style="color:rgba(255,255,255,.85)">Polo</span>
      <select class="fgs" id="gPol" onchange="applyGlobalFilter()"
        style="background:#fff;border-color:#bbb;color:#1a2228">
        <option value="">Todos</option><option value="Araçatuba">Araçatuba</option><option value="Assis">Assis</option><option value="Goiás">Goiás</option><option value="Mato Grosso do Sul">Mato Grosso do Sul</option><option value="Minas Gerais">Minas Gerais</option><option value="Norte e Nordeste">Norte e Nordeste</option><option value="Paraná">Paraná</option><option value="Piracicaba">Piracicaba</option><option value="Ribeirão Preto">Ribeirão Preto</option><option value="Rio Grande do Sul">Rio Grande do Sul</option><option value="Rio de Janeiro">Rio de Janeiro</option><option value="Santa Catarina">Santa Catarina</option><option value="Santos">Santos</option><option value="Uberlândia">Uberlândia</option>
      </select>
    </div>
    <div class="fg"><span class="fgl" style="color:rgba(255,255,255,.85)">Estado</span>
      <select class="fgs" id="gEst" onchange="applyGlobalFilter()"
        style="background:#fff;border-color:#bbb;color:#1a2228">
        <option value="">Todos</option><option value="CE">CE</option><option value="GO">GO</option><option value="MG">MG</option><option value="MS">MS</option><option value="PA">PA</option><option value="PR">PR</option><option value="RJ">RJ</option><option value="RS">RS</option><option value="SC">SC</option><option value="SP">SP</option><option value="TO">TO</option>
