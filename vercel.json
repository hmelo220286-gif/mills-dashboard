// ── EXPORT ─────────────────────────────────────────────────────────────
function doExport(fmt){
  var src=VIS_MR.length?VIS_MR:BASE_MR;
  var hdrs=['Frota','Grupo','Modelo','S\u00e9rie','Status','Unidade','Cidade','Estado','Polo',
    'Marca','Encarregado','Gerente','Mec\u00e2nico','OM','Descri\u00e7\u00e3o OM','Criticidade',
    'Hor\u00edmetro','Hs Ap\u00f3s Troca','Data Execu\u00e7\u00e3o','Data Prev. Entrega','Observa\u00e7\u00e3o'];
  var rows=src.map(function(d){
    var e2=EDITS[d.frota]||{};
    return[d.frota,d.grupo,d.modelo,d.serie,d.status,d.unidade,d.cidade,d.estado,d.polo,
      d.marca,d.encarregado,d.gerente,d.mecanico,d.om,d.desc_om,d.criticidade,
      d.hor_atual,d.horas_apos,d.data_exec,e2.dp||d.data_prev||'',e2.ob||d.obs_op||''].map(function(v){return v||'';});
  });
  if(fmt==='csv'){
    var NL=String.fromCharCode(10);
    var csvR=[hdrs.join(';')];
    rows.forEach(function(r){csvR.push(r.map(function(c){return'"'+String(c).replace(/"/g,'""')+'"';}).join(';'));});
    dl(new Blob(['\uFEFF'+csvR.join(NL)],{type:'text/csv;charset=utf-8'}),'mills_mr_'+today()+'.csv');
  }else{
    var xls='<html><head><meta charset="UTF-8"></head><body><table>';
    xls+='<tr>'+hdrs.map(function(h){return'<th style="background:#004042;color:white;font-weight:bold">'+h+'</th>';}).join('')+'</tr>';
    rows.forEach(function(r){xls+='<tr>'+r.map(function(c){return'<td>'+String(c).replace(/</g,'&lt;')+'</td>';}).join('')+'</tr>';});
    xls+='</table></body></html>';
    dl(new Blob([xls],{type:'application/vnd.ms-excel;charset=utf-8'}),'mills_mr_'+today()+'.xls');
  }
  showToast('\u2713 Exportado');
}
function exportEdits(){
  var regs=Object.keys(EDITS).filter(function(fr){var e=EDITS[fr];return e&&(e.dp||e.ob);});
  if(!regs.length){showToast('\u26A0 Nenhuma anota\u00e7\u00e3o');return;}
  var NL=String.fromCharCode(10);
  var rows=['Frota;Data Prev. Entrega;Observa\u00e7\u00e3o'];
  regs.forEach(function(fr){
    var e=EDITS[fr]||{};
    rows.push('"'+fr+'";"'+(e.dp||'')+'";\"'+(e.ob||'').replace(/"/g,'""')+'"');
  });
  dl(new Blob([rows.join(NL)],{type:'text/csv;charset=utf-8'}),'mills_anotacoes_'+today()+'.csv');
  showToast('\u2713 '+regs.length+' anota\u00e7\u00f5es exportadas');
}

// ── IMPORT ─────────────────────────────────────────────────────────────
function openU(){document.getElementById('ubg').classList.add('show');}
function closeU(){document.getElementById('ubg').classList.remove('show');}
function loadF(file){
  if(!file)return;
  var reader=new FileReader();
  if(file.name.toLowerCase().endsWith('.json')){
    reader.onload=function(ev){
      try{
        var d=JSON.parse(ev.target.result);
        if(!Array.isArray(d))d=Object.values(d);
        BASE_MR.length=0;d.forEach(function(r){BASE_MR.push(r);});
        closeU();applyGlobalFilter();
        showToast('\u2713 '+d.length+' registros importados');
      }catch(err){showToast('Erro: '+err.message);}
    };
    reader.readAsText(file,'UTF-8');
  }else{showToast('Use .json para importar');closeU();}
}

// ── COLUNAS ────────────────────────────────────────────────────────────
function toggleCP(){document.getElementById('cpanel').classList.toggle('show');}
document.addEventListener('click',function(e){
  if(!e.target.closest('.cwrap')){var cp=document.getElementById('cpanel');if(cp)cp.classList.remove('show');}
});
function toggleCol(col,cb){
  document.querySelectorAll('#mt th:nth-child('+(col+1)+'),#mt td:nth-child('+(col+1)+')')
    .forEach(function(el){el.style.display=cb.checked?'':'none';});
}

// ── UTILS ──────────────────────────────────────────────────────────────
function cc(c){
  if(!c)return'Z';var u=c.toUpperCase();
  if(u.indexOf('URGENTE')>=0)return'U';
  if(u.indexOf('COMUNICAR')>=0)return'C';
  if(u.indexOf('NORMAL')>=0)return'N';
  if(u.indexOf('RODANTE')>=0||u==='OK')return'O';
  return'Z';
}
function cl(c){
  var k=cc(c);
  if(k==='U')return'\u26a0 Urgente';
  if(k==='C')return'\u2709 Comunicar Oficina';
  if(k==='N')return'\u2713 Normal';
  if(k==='O')return'\u2714 Rodante OK';
  return'Sem dados';
}
function esc(s){
  if(!s||s==='null'||s==='undefined')return'';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function nf(n){return(n||0).toLocaleString('pt-BR',{maximumFractionDigits:1});}
function toISO(s){
  if(!s)return'';
  if(s.indexOf('-')>=0)return s.substring(0,10);
  var p=s.split('/');
  if(p.length===3)return p[2].substring(0,4)+'-'+('0'+p[1]).slice(-2)+'-'+('0'+p[0]).slice(-2);
  return'';
}
function today(){return new Date().toISOString().slice(0,10);}
function dl(blob,name){var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();}
function cntBy(arr,fn){var m={};arr.forEach(function(d){var k=fn(d);if(k)m[k]=(m[k]||0)+1;});return m;}
function showToast(msg){
  var t=document.getElementById('toast');
  t.textContent=msg;t.classList.add('show');
  setTimeout(function(){t.classList.remove('show');},2800);
}

// ── GRÁFICOS ───────────────────────────────────────────────────────────
function drawPie(id,labels,vals,colors){
  var c=document.getElementById(id);if(!c)return;
  var W=c.parentElement.clientWidth-28||280,H=parseInt(c.getAttribute('height'))||240;
  if(W<=0)W=280;
  c.width=W;c.height=H;
  var ctx=c.getContext('2d');
  var total=vals.reduce(function(a,b){return a+b;},0);if(!total)return;
  var cx=W*0.34,cy=H/2,r=Math.max(10,Math.min(cx,cy)-14),ang=-Math.PI/2;
  for(var i=0;i<vals.length;i++){
    if(!vals[i])continue;
    var sl=vals[i]/total*2*Math.PI;
    ctx.beginPath();ctx.moveTo(cx,cy);ctx.arc(cx,cy,r,ang,ang+sl);
    ctx.closePath();ctx.fillStyle=colors[i%colors.length];ctx.fill();
    if(sl>0.2){
      ctx.fillStyle='#fff';ctx.font='bold 12px sans-serif';
      ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillText(Math.round(vals[i]/total*100)+'%',
        cx+r*.65*Math.cos(ang+sl/2),cy+r*.65*Math.sin(ang+sl/2));
    }
    ang+=sl;
  }
  var lx=W*.70,ly0=cy-(labels.length*18)/2;
  for(var j=0;j<labels.length;j++){
    if(!vals[j])continue;
    var ly=ly0+j*20;
    ctx.fillStyle=colors[j%colors.length];ctx.fillRect(lx,ly-5,8,8);
    ctx.fillStyle='#4a5568';ctx.font='12px sans-serif';ctx.textAlign='left';ctx.textBaseline='middle';
    var lb=labels[j].length>16?labels[j].substring(0,15)+'\u2026':labels[j];
    ctx.fillText(lb,lx+11,ly);
    ctx.fillStyle='#8a96a4';ctx.font='bold 12px sans-serif';
    ctx.fillText(vals[j],lx+11+ctx.measureText(lb).width+4,ly);
  }
}
function drawHBar(id,labels,vals,color){
  var c=document.getElementById(id);if(!c)return;
  if(!labels||!labels.length)return;
  var W=c.parentElement.clientWidth-28||320,rH=24,pad=7,lbW=140;
  var H=labels.length*(rH+pad)+12;
  if(W<=0)W=320;
  c.width=W;c.height=H;
  var ctx=c.getContext('2d'),mx=Math.max.apply(null,vals)||1,bW=W-lbW-28;
  if(bW<=0)return;
  for(var i=0;i<labels.length;i++){
    var y=i*(rH+pad)+6;
    ctx.fillStyle='#4a5568';ctx.font='12px sans-serif';ctx.textAlign='right';ctx.textBaseline='middle';
    var lb=labels[i].length>20?labels[i].substring(0,19)+'\u2026':labels[i];
    ctx.fillText(lb,lbW-4,y+rH/2);
    ctx.fillStyle='#f0f3f5';ctx.beginPath();
    if(ctx.roundRect)ctx.roundRect(lbW,y,bW,rH,3);else ctx.rect(lbW,y,bW,rH);
    ctx.fill();
    var fw=Math.max(0,bW*(vals[i]/mx));
    ctx.fillStyle=color;ctx.beginPath();
    if(ctx.roundRect)ctx.roundRect(lbW,y,fw,rH,3);else ctx.rect(lbW,y,fw,rH);
    ctx.fill();
    ctx.fillStyle=fw>28?'#fff':'#4a5568';ctx.font='bold 12px sans-serif';
    ctx.textAlign='left';ctx.textBaseline='middle';
    ctx.fillText(vals[i],fw>28?lbW+4:lbW+fw+3,y+rH/2);
  }
}

// ═══════════════════════════════════════════════════════
//  SYNC SUPABASE — versão limpa e simples
// ═══════════════════════════════════════════════════════
var SYNC_TIMER = null;

// ── Carregar do servidor ao abrir ──────────────────────
function initSync() {
  var lbl = document.getElementById('sync-label');
  var sub = document.getElementById('sync-sub');
  if (lbl) lbl.innerHTML = '\uD83D\uDFE2 Modo sincronizado \u2014 anota\u00e7\u00f5es compartilhadas com o time';
  if (sub) sub.textContent = 'Carregando...';
  loadFromServer(true);
  // Auto-refresh silencioso a cada 30s
  setInterval(function() { loadFromServer(false); }, 30000);
}

function loadFromServer(rerender) {
  var sub = document.getElementById('sync-sub');
  fetch('/api/anotacoes')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      // Atualizar EDITS com dados do servidor
      Object.keys(data).forEach(function(fr) {
        if (!EDITS[fr]) EDITS[fr] = {};
        EDITS[fr].dp = data[fr].dp;
        EDITS[fr].ob = data[fr].ob;
      });
      try { localStorage.setItem('mills_v3', JSON.stringify(EDITS)); } catch(e) {}

      if (rerender) {
        // Primeira carga: re-renderizar tabela para mostrar dados
        applyGlobalFilter();
      } else {
        // Refresh silencioso: atualizar só campos que não estão em foco
        Object.keys(data).forEach(function(fr) {
          var dpEl = document.querySelector('[data-fr="' + fr + '"][data-f="dp"]');
          var obEl = document.querySelector('[data-fr="' + fr + '"][data-f="ob"]');
          if (dpEl && document.activeElement !== dpEl) dpEl.value = data[fr].dp || '';
          if (obEl && document.activeElement !== obEl) obEl.value = data[fr].ob || '';
        });
      }
      if (sub) sub.textContent = '\u2713 Sincronizado: ' + new Date().toLocaleTimeString('pt-BR');
    })
    .catch(function() {
      if (sub) sub.textContent = 'Usando dados locais.';
    });
}

// ── Salvar campo específico no servidor ────────────────
function ed(el) {
  var fr  = el.dataset.fr;
  var f   = el.dataset.f;
  var val = el.value;

  // Salvar local
  if (!EDITS[fr]) EDITS[fr] = {};
  EDITS[fr][f] = val;
  try { localStorage.setItem('mills_v3', JSON.stringify(EDITS)); } catch(e) {}

  // Indicar salvando
  var sub = document.getElementById('sync-sub');
  if (sub) sub.textContent = 'Salvando...';

  // Debounce 800ms — salvar no servidor
  if (SYNC_TIMER) clearTimeout(SYNC_TIMER);
  SYNC_TIMER = setTimeout(function() {
    fetch('/api/anotacoes', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ frota: fr, field: f, value: val })
    })
    .then(function(r) { return r.json(); })
    .then(function(result) {
      var sub2 = document.getElementById('sync-sub');
      if (result.ok) {
        if (sub2) sub2.textContent = '\u2713 Salvo ' + new Date().toLocaleTimeString('pt-BR');
      } else {
        if (sub2) sub2.textContent = '\u26A0 Erro: ' + (result.error || 'tente novamente');
      }
    })
    .catch(function() {
      var sub2 = document.getElementById('sync-sub');
      if (sub2) sub2.textContent = '\u26A0 Sem conex\u00e3o com servidor';
    });
  }, 800);
}

function saveAll() {
  showToast('\u2713 Dados salvos automaticamente');
}

// ── INIT ───────────────────────────────────────────────────────────────
applyGlobalFilter();
initSync();

</script>
